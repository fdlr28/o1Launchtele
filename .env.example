# Salin file ini menjadi .env lalu isi. JANGAN commit .env (sudah ada di .gitignore).

# --- Wajib -------------------------------------------------------------------

# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=

# ID Telegram numerik yang boleh memakai bot, pisahkan dengan koma.
# Tidak tahu ID kamu? Jalankan bot lalu kirim /id (perintah itu bisa dipakai siapa saja).
ALLOWED_USER_IDS=

# Private key wallet LAUNCHER (hot wallet). Pakai wallet khusus berisi dana secukupnya,
# jangan wallet utama. Boleh dengan atau tanpa awalan 0x.
PRIVATE_KEY=

# API key o1 dari https://launch.o1.exchange/developers
# Scope yang dibutuhkan: config:read, tokens:read, launches:prepare, swaps:quote, swaps:prepare
O1_API_KEY=

# --- RPC ---------------------------------------------------------------------
# Bot hanya mengaktifkan chain yang RPC-nya menjawab dengan chain id yang benar.
# RPC publik di bawah punya rate limit; untuk pemakaian serius pakai RPC pribadi
# (Alchemy, QuickNode, dll.). Robinhood Chain (4663) dan Arc (5042) tidak punya
# default: isi RPC-nya sendiri kalau mau memakainya.

# RPC_URL_8453=https://mainnet.base.org
# RPC_URL_56=https://bsc-dataseed.binance.org
# RPC_URL_196=https://rpc.xlayer.tech
# RPC_URL_143=https://rpc.monad.xyz
# RPC_URL_4663=
# RPC_URL_5042=

# Batasi chain yang dipakai (default: semua chain yang punya RPC)
# ENABLED_CHAINS=8453,56

# Link explorer untuk chain yang belum punya bawaan (dipakai untuk link tx)
# EXPLORER_URL_143=
# EXPLORER_URL_5042=

# --- Opsional ------------------------------------------------------------------

# Slippage bawaan dev buy dalam bps (500 = 5%), 1-4999
# DEV_BUY_SLIPPAGE_BPS=500

# Bot hanya menandatangani transaksi ke kontrak yang dipublikasikan o1 lewat /config, dan
# pemeriksaan itu tidak bisa dimatikan. Kalau kamu SUDAH memverifikasi sendiri bahwa sebuah
# kontrak o1 tambahan memang sah (mis. router baru yang belum masuk /config), daftarkan
# alamatnya di sini (pisahkan dengan koma). Kontrak ini boleh dipanggil dan di-approve.
# Juga untuk chain yang memakai Permit2 NON-kanonis: Permit2 kanonis
# (0x000000000022D473030F116dDEE9F6B43aC78BA3) selalu dipercaya, yang lain hanya bila didaftarkan di sini.
# Isi hanya kalau kamu benar-benar paham risikonya; biarkan kosong untuk pemakaian normal.
# EXTRA_ALLOWED_TARGETS=

# Folder catatan launch (launches.jsonl)
# DATA_DIR=./data

# debug | info | warn | error
# LOG_LEVEL=info

# Hanya jika kamu menjalankan server Telegram Bot API sendiri
# TELEGRAM_API_ROOT=

# Hanya jika kamu perlu mengganti endpoint API o1
# O1_API_BASE_URL=https://api.launch.o1.exchange/v1

# Catatan: semua URL (RPC, API o1, Telegram, explorer) harus https://. http:// hanya diterima
# untuk localhost / 127.0.0.1, mis. node RPC di mesin yang sama.
